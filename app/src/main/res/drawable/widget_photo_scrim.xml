<?xml version="1.0" encoding="utf-8"?>
<!-- Dark gradient placed over the quote's own photo so the text stays legible — same
     top-to-bottom darkening QuoteDetailContent uses for the full-screen quote view. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#66000000"
        android:centerColor="#99000000"
        android:endColor="#E6000000"
        android:angle="270" />
    <corners android:radius="20dp" />
</shape>
